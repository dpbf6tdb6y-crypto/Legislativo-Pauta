generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String   @id @default(cuid())
  nome                     String
  email                    String   @unique
  senha                    String
  perfil                   String   @default("operador")
  ativo                    Boolean  @default(true)
  podeVerIndicacoes        Boolean  @default(false)
  acessos                  String?
  fluxoResumido            Boolean  @default(false)
  senhaAreaRestrita        Boolean  @default(true)
  podeUsarMicrofone        Boolean  @default(true)
  podeVerConfiguracoes     Boolean  @default(false)
  podeCriar                Boolean  @default(true)
  podeEditar               Boolean  @default(true)
  podeExcluir              Boolean  @default(true)
  podeImportar             Boolean  @default(true)
  podeExportar             Boolean  @default(true)
  podeGerenciarVereadores  Boolean  @default(true)
  podeVerAuditoria         Boolean  @default(true)
  createdAt                DateTime @default(now())

  // Gestão $$$: perfil do usuário nos módulos financeiros (vazio = sem acesso aos módulos;
  // Master/Admin sem perfil entram como "administrador"). Secretaria: só a própria (gestaoOrgaoCod).
  gestaoPerfil   String?
  gestaoOrgaoCod String  @default("")
}

model Vereador {
  id          String   @id @default(cuid())
  nome        String
  apelido     String?
  partido     String
  legislatura String
  telefone    String?
  email       String?
  cargo       String?
  poder       String   @default("legislativo")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  comissoes      ComissaoMembro[]
  proposicoes    ProposicaoAutor[]
  votosPareceres VotoParecerVereador[]
  emendas        Emenda[]             @relation("EmendaAutorVereador")
  segov          Segov[]
  requerimentos  Requerimento[]       @relation("RequerimentoAutor")
  tags           Tag[]                @relation("TagAutor")
  indicacoes     IndicacaoCargo[]
  pedidos        PedidoVereador[]

  @@index([nome])
  @@index([ativo])
}

model Empresa {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  indicacoes IndicacaoCargo[]
}

model IndicacaoCargo {
  id           String    @id @default(cuid())
  vereadorId   String?
  indicado     String
  empresaId    String?
  cargo        String
  salario      Float?
  status       String    @default("Aguardando")
  dataInicio   DateTime?
  dataFim      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vereador Vereador? @relation(fields: [vereadorId], references: [id])
  empresa  Empresa?  @relation(fields: [empresaId], references: [id])
}

model SolicitacaoRelatorio {
  id              String    @id @default(cuid())
  solicitanteId   String
  solicitanteNome String
  aprovadorId     String
  aprovadorNome   String
  status          String    @default("pendente")
  createdAt       DateTime  @default(now())
  respondidoEm    DateTime?
}

model Comissao {
  id        String   @id @default(cuid())
  nome      String
  sigla     String?
  tipo      String   @default("permanente")
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  membros     ComissaoMembro[]
  analistas   Analista[]
  tramitacoes ProposicaoComissao[]
}

model ComissaoMembro {
  id         String   @id @default(cuid())
  comissaoId String
  vereadorId String
  papel      String
  createdAt  DateTime @default(now())

  comissao Comissao @relation(fields: [comissaoId], references: [id])
  vereador Vereador @relation(fields: [vereadorId], references: [id])

  @@unique([comissaoId, papel])
}

model Analista {
  id         String   @id @default(cuid())
  nome       String
  email      String?
  telefone   String?
  comissaoId String   @unique
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  comissao  Comissao           @relation(fields: [comissaoId], references: [id])
  pareceres ProposicaoComissao[]
}

model Proposicao {
  id              String   @id @default(cuid())
  numero          String
  ano             Int
  tipo            String
  ementa          String
  origemTipo      String
  autorExterno    String?
  dataEntrada     DateTime
  status          String   @default("em_tramitacao")
  dispensaParecer     Boolean  @default(false)
  dispensaIntersticio Boolean  @default(false)
  regimeUrgencia      Boolean  @default(false)
  numVotacoes         Int      @default(1)
  etapaAtual          String   @default("protocolado")
  destinoFinal        String   @default("sancao")
  setorAtual          String?
  protocolo           String?
  createdAt           DateTime @default(now())

  autores       ProposicaoAutor[]
  comissoes     ProposicaoComissao[]
  emendas       Emenda[]
  pautaItens    PautaItem[]

  @@index([status])
  @@index([ano])
  @@index([tipo])
}

model ProposicaoAutor {
  id           String     @id @default(cuid())
  proposicaoId String
  vereadorId   String
  createdAt    DateTime   @default(now())

  proposicao   Proposicao @relation(fields: [proposicaoId], references: [id])
  vereador     Vereador   @relation(fields: [vereadorId], references: [id])

  @@unique([proposicaoId, vereadorId])
}

model ProposicaoComissao {
  id              String    @id @default(cuid())
  proposicaoId    String
  comissaoId      String
  analistaId      String?
  ordem           Int
  status          String    @default("aguardando")
  parecer         String?
  parecerTexto    String?
  parecerConjunto Boolean   @default(false)
  dataEnvio       DateTime?
  dataVotacao     DateTime?
  createdAt       DateTime  @default(now())

  proposicao Proposicao          @relation(fields: [proposicaoId], references: [id])
  comissao   Comissao            @relation(fields: [comissaoId], references: [id])
  analista   Analista?           @relation(fields: [analistaId], references: [id])
  votos      VotoParecerVereador[]
}

model VotoParecerVereador {
  id                   String   @id @default(cuid())
  proposicaoComissaoId String
  vereadorId           String
  aprovado             Boolean
  createdAt            DateTime @default(now())

  proposicaoComissao ProposicaoComissao @relation(fields: [proposicaoComissaoId], references: [id])
  vereador           Vereador           @relation(fields: [vereadorId], references: [id])

  @@unique([proposicaoComissaoId, vereadorId])
}

model Emenda {
  id              String   @id @default(cuid())
  proposicaoId    String
  tipo            String
  autorVereadorId String?
  autorNome       String?
  artigo          String
  texto           String
  createdAt       DateTime @default(now())

  proposicao    Proposicao @relation(fields: [proposicaoId], references: [id])
  autorVereador Vereador?  @relation("EmendaAutorVereador", fields: [autorVereadorId], references: [id])
}

model Sessao {
  id        String   @id @default(cuid())
  data      DateTime
  tipo      String
  numero    Int?
  ano       Int?
  local     String?
  status    String   @default("agendada")
  ata       String?
  createdAt DateTime @default(now())

  itens PautaItem[]
}

model PautaItem {
  id           String   @id @default(cuid())
  sessaoId     String
  proposicaoId String
  ordem        Int
  secao        String   @default("votacao")
  resultado    String?
  observacoes  String?
  createdAt    DateTime @default(now())

  sessao     Sessao     @relation(fields: [sessaoId], references: [id])
  proposicao Proposicao @relation(fields: [proposicaoId], references: [id])
}

model Segov {
  id              String    @id @default(cuid())
  numero          String
  ano             Int       @default(2026)
  tipo            String
  ementa          String
  vereadorId      String?
  autorNome       String?
  status          String    @default("Aguardando")
  dataEnvio       DateTime?
  observacao      String?   // comissão de destino (apresentação)
  parecerComissao String?   // comissão(ões) que emitiram o parecer
  parecerConjunto Boolean   @default(false)
  proxComissao    String?   // próxima comissão após o parecer
  dataParecere    DateTime? // data da sessão em que o parecer foi lido
  fluxo           Json?     // fluxo de tramitação (passos marcados)
  setorAtual      String?   // setor/comissão atual (importação de planilha)
  protocolo       String?   // número de protocolo (importação de planilha)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vereador Vereador? @relation(fields: [vereadorId], references: [id])

  @@index([status])
  @@index([ano])
  @@index([tipo])
  @@index([vereadorId])
}

model ConfigOpcao {
  id        String   @id @default(cuid())
  tipo      String   // 'origem' | 'categoria' | 'secretaria' | 'tipo_requerimento' | 'tipo_proposicao'
  nome      String
  codigo    String?  // usado por 'tipo_requerimento' para vincular ao código interno (REQ/MOC/IND)
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([tipo, nome])
}

model Requerimento {
  id         String    @id @default(cuid())
  numero     String
  ano        Int       @default(2026)
  tipo       String
  descricao  String
  vereadorId String?
  autorNome  String?
  status     String    @default("Aguardando")
  dataEnvio  DateTime?
  fluxo      Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vereador Vereador? @relation("RequerimentoAutor", fields: [vereadorId], references: [id])

  @@index([status])
  @@index([ano])
  @@index([tipo])
  @@index([vereadorId])
}

model LogImportacao {
  id           String   @id @default(cuid())
  origem       String   // 'segov_planilha' | 'segov_arquivo' | 'segov_texto'
  arquivoNome  String?
  criados      Int      @default(0)
  atualizados  Int      @default(0)
  ignorados    Int      @default(0)
  erros        Int      @default(0)
  detalhes     Json?    // lista de itens com problema, avisos, etc.
  usuarioId    String?
  usuarioNome  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Tag {
  id            String    @id @default(cuid())
  referencia    String    @unique
  data          DateTime
  pedido        String
  status        String    @default("Aguardando")
  relevancia    String?
  vereadorId    String?
  origem        String?
  categoria     String?
  secretaria    String?
  dataConclusao DateTime?
  documentos    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vereador Vereador? @relation("TagAutor", fields: [vereadorId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  acao        String
  entidade    String
  entidadeId  String?
  referencia  String?
  detalhes    String?
  usuarioId   String?
  usuarioNome String?
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade])
}

model Config {
  id    String @id @default(cuid())
  chave String @unique
  valor String
}

model ResetSenha {
  id       String   @id @default(cuid())
  token    String   @unique
  email    String
  expiraEm DateTime
  usado    Boolean  @default(false)
  criadoEm DateTime @default(now())
}

// SRM — pedidos dos vereadores ao Poder Executivo (módulo Ind.)
model PedidoVereador {
  id             String    @id @default(cuid())
  vereadorId     String?
  tipo           String
  descricao      String
  endereco       String?
  dataPedido     DateTime
  prazo          DateTime?
  status         String    @default("Em andamento")
  referencia     Int?
  dataFechamento DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vereador   Vereador?          @relation(fields: [vereadorId], references: [id])
  andamentos AndamentoPedido[]

  @@index([vereadorId])
  @@index([status])
  @@index([dataPedido])
}

model AndamentoPedido {
  id        String   @id @default(cuid())
  pedidoId  String
  data      DateTime
  descricao String
  status    String?
  createdAt DateTime @default(now())

  pedido PedidoVereador @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

// =====================================================================
// Gestão $$$: dados financeiros da Prefeitura (base vinda do compliance.gavix)
// Tabelas com prefixo fin_. Dinheiro sempre em CENTAVOS inteiros (BigInt).
// Toda tabela tem prefeituraId ("nova-lima"): o código de coleta usa um
// cliente preso à prefeitura (lib/financas/db.ts).
// =====================================================================

model Prefeitura {
  id             String   @id
  nome           String
  uf             String
  ibge           Int
  conector       String // abaco | arquivo
  conectorConfig String   @default("{}")
  criadoEm       DateTime @default(now())

  @@map("fin_prefeitura")
}

model Coleta {
  id                 Int       @id @default(autoincrement())
  prefeituraId       String
  inicio             DateTime  @default(now())
  fim                DateTime?
  status             String // rodando | ok | divergencia | falha | interrompida
  portalAtualizadoEm String    @default("")
  resumo             String    @default("{}") // JSON
  erros              String    @default("")

  @@index([prefeituraId, inicio])
  @@map("fin_coleta")
}

// arquivo baixado do portal: fica em disco por 30 dias; o SHA-256 fica aqui para sempre
model ArquivoBruto {
  id           Int       @id @default(autoincrement())
  prefeituraId String
  coletaId     Int
  fonte        String
  tipo         String
  referencia   String
  caminho      String
  sha256       String
  bytes        Int
  baixadoEm    DateTime  @default(now())
  apagadoEm    DateTime? // quando o arquivo saiu do disco (limpeza de 30 dias)

  @@index([prefeituraId, tipo, baixadoEm])
  @@map("fin_arquivo_bruto")
}

model DespesaOrgaoMes {
  prefeituraId String
  ano          Int
  mes          Int // 0 = ano inteiro (acumulado)
  orgaoCod     String
  orgaoNome    String
  dotInicial   BigInt
  dotAtual     BigInt
  empenhado    BigInt
  liquidado    BigInt
  pago         BigInt
  coletaId     Int

  @@id([prefeituraId, ano, mes, orgaoCod])
  @@map("fin_despesa_orgao_mes")
}

// Relatórios consolidados do portal (visão Natureza): é daqui que sai o total por natureza, nunca da soma de empenhos
model DespesaNaturezaMes {
  prefeituraId String
  ano          Int
  mes          Int // 0 = ano inteiro (acumulado)
  naturezaCod  String // 319011 (os 2 primeiros dígitos são o grupo: 31 = pessoal)
  naturezaNome String
  dotInicial   BigInt
  dotAtual     BigInt
  empenhado    BigInt
  liquidado    BigInt
  pago         BigInt
  coletaId     Int

  @@id([prefeituraId, ano, mes, naturezaCod])
  @@map("fin_despesa_natureza_mes")
}

// Relatórios consolidados do portal (visão Função/Subfunção)
model DespesaFuncaoMes {
  prefeituraId  String
  ano           Int
  mes           Int // 0 = ano inteiro (acumulado)
  funcaoCod     String
  funcaoNome    String
  subfuncaoCod  String
  subfuncaoNome String
  dotInicial    BigInt
  dotAtual      BigInt
  empenhado     BigInt
  liquidado     BigInt
  pago          BigInt
  coletaId      Int

  @@id([prefeituraId, ano, mes, funcaoCod, subfuncaoCod])
  @@map("fin_despesa_funcao_mes")
}

// Trava de conferência: o que o portal mostra × o RREO homologado no SICONFI, bimestre a bimestre
model ConferenciaOficial {
  prefeituraId String
  ano          Int
  bimestre     Int
  item         String // receita | empenhado | liquidado | pago | natureza | funcao | grupo:31 | funcao:SAUDE
  rotulo       String
  oficial      BigInt
  portal       BigInt
  diferenca    BigInt // portal − oficial
  confere      Boolean
  coletaId     Int
  conferidoEm  DateTime @default(now())

  @@id([prefeituraId, ano, bimestre, item])
  @@map("fin_conferencia_oficial")
}

model Empenho {
  id             Int      @id @default(autoincrement())
  prefeituraId   String
  idOrigem       Int
  numero         String
  data           DateTime
  ano            Int
  tipo           String
  orgao          String
  unidade        String
  credorDoc      String
  credorNome     String
  processo       String
  natureza       String
  contaDespesa   String
  fonte          String
  funcao         String
  subfuncao      String
  programa       String
  projeto        String
  descricao      String
  contratoCitado String? // 0252/2025, extraído da descrição
  valor          BigInt
  anulado        BigInt
  aLiquidar      BigInt
  aPagar         BigInt
  // a fonte publica valores que não fecham entre si (ex.: a liquidar negativo); gravado como veio, com o motivo
  inconsistencia String?
  atualizadoEm   DateTime @default(now())

  liquidacoes Liquidacao[]
  pagamentos  Pagamento[]

  @@unique([prefeituraId, idOrigem])
  @@index([prefeituraId, credorDoc])
  @@index([prefeituraId, data])
  @@index([prefeituraId, ano])
  @@map("fin_empenho")
}

model Liquidacao {
  id           Int      @id @default(autoincrement())
  prefeituraId String
  idOrigem     Int
  empenhoId    Int
  numero       String
  data         DateTime
  valor        BigInt
  empenho      Empenho  @relation(fields: [empenhoId], references: [id], onDelete: Cascade)

  @@unique([prefeituraId, idOrigem])
  @@index([prefeituraId, data])
  @@index([empenhoId])
  @@map("fin_liquidacao")
}

model Pagamento {
  id           Int      @id @default(autoincrement())
  prefeituraId String
  idOrigem     Int
  empenhoId    Int
  numero       String
  data         DateTime
  valor        BigInt
  empenho      Empenho  @relation(fields: [empenhoId], references: [id], onDelete: Cascade)

  @@unique([prefeituraId, idOrigem])
  @@index([prefeituraId, data])
  @@index([empenhoId])
  @@map("fin_pagamento")
}

// descontos retidos em cada pagamento (IRRF, ISS, INSS, consignados). Ligados pelo id do pagamento NA FONTE,
// para sobreviver à releitura do empenho (que recria os pagamentos). Lido uma vez por pagamento.
model RetencaoLeitura {
  id                Int      @id @default(autoincrement())
  prefeituraId      String
  pagamentoIdOrigem Int
  total             BigInt
  itens             Int
  lidaEm            DateTime @default(now())

  @@unique([prefeituraId, pagamentoIdOrigem])
  @@map("fin_retencao_leitura")
}

model Retencao {
  id                Int       @id @default(autoincrement())
  prefeituraId      String
  pagamentoIdOrigem Int
  seq               Int
  descricao         String
  tipo              String
  data              DateTime?
  valor             BigInt

  @@unique([prefeituraId, pagamentoIdOrigem, seq])
  @@map("fin_retencao")
}

// restos a pagar do exercício (posição do dia). Os pagamentos com data ficam no empenho de origem (empenho de ano anterior).
model RestoPagar {
  id              Int      @id @default(autoincrement())
  prefeituraId    String
  idOrigem        Int
  numero          String
  anoOrigem       Int
  exercicio       Int
  tipo            String // P processado | N não processado | L não processado liquidado
  empenhoIdOrigem Int
  empenhoNumero   String
  orgaoCod        String
  orgaoNome       String
  credorDoc       String
  credorNome      String
  inscrito        BigInt
  anulado         BigInt
  liquidado       BigInt
  pago            BigInt
  atualizadoEm    DateTime @default(now())

  @@unique([prefeituraId, idOrigem])
  @@index([prefeituraId, exercicio])
  @@index([prefeituraId, empenhoIdOrigem])
  @@map("fin_resto_pagar")
}

model Contrato {
  id                Int       @id @default(autoincrement())
  prefeituraId      String
  idOrigem          Int
  numero            String // 0252
  ano               Int
  assinatura        DateTime?
  inicio            DateTime?
  fim               DateTime?
  publicacaoData    DateTime?
  publicacaoVeiculo String
  objeto            String
  tipo              String
  situacao          String
  valorInicial      BigInt
  valorAtual        BigInt
  processo          String
  modalidade        String
  fornecedorDoc     String
  fornecedorNome    String

  @@unique([prefeituraId, idOrigem])
  @@index([prefeituraId, fornecedorDoc])
  @@map("fin_contrato")
}

// o portal não publica a ligação: ela é deduzida e o grau de certeza fica visível
model LigacaoContratoEmpenho {
  prefeituraId String
  contratoId   Int
  empenhoId    Int
  certeza      String // alta | media
  motivo       String

  @@id([prefeituraId, contratoId, empenhoId])
  @@index([prefeituraId, empenhoId])
  @@map("fin_ligacao_contrato_empenho")
}

model ReceitaContaMes {
  prefeituraId    String
  ano             Int
  mes             Int
  contaCod        String
  contaPai        String
  nome            String
  redutora        Boolean
  previstoInicial BigInt
  previstoAtual   BigInt
  arrecAnterior   BigInt
  arrecMes        BigInt
  arrecAteMes     BigInt

  @@id([prefeituraId, ano, mes, contaCod])
  @@map("fin_receita_conta_mes")
}

// ---------- Gestão $$$: acessos e chaves (liga/desliga de módulos) ----------

model RegistroAcesso {
  id           Int      @id @default(autoincrement())
  prefeituraId String
  usuarioId    String
  usuarioNome  String
  perfil       String
  quando       DateTime @default(now())
  acao         String // ver | buscar | exportar | login | alterar
  tela         String
  detalhe      String   @default("")

  @@index([prefeituraId, quando])
  @@map("fin_registro_acesso")
}

model Chave {
  prefeituraId String
  nome         String
  ligada       Boolean
  alteradoPor  String   @default("sistema")
  alteradoEm   DateTime @default(now())

  @@id([prefeituraId, nome])
  @@map("fin_chave")
}

model ChaveHistorico {
  id           Int      @id @default(autoincrement())
  prefeituraId String
  nome         String
  de           Boolean
  para         Boolean
  por          String
  quando       DateTime @default(now())

  @@map("fin_chave_historico")
}

// ---------- Gestão $$$: pessoal ----------

model FolhaMes {
  prefeituraId    String
  anoMes          String // 2026/10
  linhasPortal    Int
  linhasColetadas Int
  coletaId        Int

  @@id([prefeituraId, anoMes])
  @@map("fin_folha_mes")
}

// LGPD: sem CPF, sem dados bancários, sem detalhe de descontos, situação resumida.
// O nome só aparece na tela para os perfis autorizados e com a chave folha_nomes ligada.
model FolhaLinha {
  id           Int    @id @default(autoincrement())
  prefeituraId String
  anoMes       String
  seq          Int // ordem da linha no portal
  matricula    String
  nome         String
  cargo        String
  ocupacao     String
  tipoVinculo  String
  situacao     String // em exercício | afastado | desligado | aposentado/pensionista | outro
  lotacao      String
  vencimentos  BigInt
  bruto        BigInt
  previdencia  BigInt
  desconto     BigInt
  irrf         BigInt
  liquido      BigInt

  @@unique([prefeituraId, anoMes, seq])
  @@index([prefeituraId, nome])
  @@index([prefeituraId, matricula])
  @@map("fin_folha_linha")
}

// ---------- Gestão $$$: indicadores fiscais (SICONFI) ----------

model IndicadorFiscal {
  prefeituraId String
  ano          Int
  periodo      Int
  relatorio    String // RGF | RREO
  chave        String // rcl | dtp | dtp_pct | limite_max_pct | ...
  valor        String // decimal em texto
  coletaId     Int

  @@id([prefeituraId, ano, periodo, relatorio, chave])
  @@map("fin_indicador_fiscal")
}

// ---------- Gestão $$$: regras e apontamentos ----------

model Regra {
  prefeituraId String
  codigo       String
  titulo       String
  baseLegal    String
  descricao    String
  parametros   String    @default("{}")
  estado       String    @default("proposta") // proposta | aprovada | desligada
  decididoPor  String?
  decididoEm   DateTime?

  @@id([prefeituraId, codigo])
  @@map("fin_regra")
}

model Apontamento {
  id              Int       @id @default(autoincrement())
  prefeituraId    String
  regraCodigo     String
  chaveUnica      String // evita duplicar o mesmo apontamento
  entidade        String // empenho | contrato | indicador
  entidadeId      String
  resumo          String
  valorEncontrado String
  criadoEm        DateTime  @default(now())
  status          String    @default("para_analise") // para_analise | procedente | improcedente
  analisadoPor    String?
  analisadoEm     DateTime?
  nota            String?

  @@unique([prefeituraId, chaveUnica])
  @@index([prefeituraId, status])
  @@map("fin_apontamento")
}

// ---------- Gestão $$$: auditoria por secretaria (cobrança em reunião) ----------
// O sistema não decide o que é irregular: um ponto de auditoria é uma cobrança registrada,
// com responsável, prazo e o histórico de respostas. O histórico não se apaga.

model ResponsavelSecretaria {
  prefeituraId String
  orgaoCod     String
  nome         String
  cargo        String   @default("")
  alteradoPor  String
  alteradoEm   DateTime @default(now())

  @@id([prefeituraId, orgaoCod])
  @@map("fin_responsavel_secretaria")
}

model PontoAuditoria {
  id           Int       @id @default(autoincrement())
  prefeituraId String
  orgaoCod     String
  orgaoNome    String
  titulo       String
  descricao    String    @default("")
  baseLegal    String    @default("")
  origem       String // manual | apontamento | sugestao
  origemRef    String    @default("") // apontamento:12, sugestao:saldo:09:2026 (evita criar o mesmo ponto duas vezes)
  prazo        DateTime?
  status       String    @default("aberto") // aberto | respondido | resolvido | cancelado
  criadoPor    String
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now())

  eventos EventoAuditoria[]

  @@index([prefeituraId, orgaoCod, status])
  @@map("fin_ponto_auditoria")
}

model EventoAuditoria {
  id           Int            @id @default(autoincrement())
  prefeituraId String
  pontoId      Int
  tipo         String // criado | resposta | cobranca | status | prazo | nota
  texto        String         @default("")
  por          String // usuário que registrou
  emNomeDe     String         @default("") // quem respondeu pela secretaria (ofício, e-mail, na reunião)
  quando       DateTime       @default(now())
  ponto        PontoAuditoria @relation(fields: [pontoId], references: [id], onDelete: Cascade)

  @@index([prefeituraId, pontoId])
  @@map("fin_evento_auditoria")
}

model ReuniaoSecretaria {
  id            Int      @id @default(autoincrement())
  prefeituraId  String
  orgaoCod      String
  quando        DateTime @default(now())
  registradoPor String
  participantes String   @default("")
  notas         String   @default("")

  @@index([prefeituraId, orgaoCod, quando])
  @@map("fin_reuniao_secretaria")
}

// ---------- Gestão $$$: fila de documentos para assinar ----------
// A secretaria envia, o sistema confere, o controlador/jurídico dá parecer e o prefeito decide.
// Cada passo fica registrado, inclusive o que o prefeito tinha diante de si ao assinar.

model DocumentoAssinatura {
  id            Int       @id @default(autoincrement())
  prefeituraId  String
  tipo          String // empenho | pagamento | aditivo | contrato_novo | nomeacao | outro
  assunto       String
  descricao     String    @default("")
  valor         BigInt    @default(0) // centavos; nomeação: remuneração mensal
  dataAto       DateTime
  credorDoc     String    @default("")
  credorNome    String    @default("")
  orgaoCod      String
  orgaoNome     String
  contrato      String    @default("") // 252/2025
  prazo         DateTime? // até quando precisa ser assinado
  status        String    @default("em_conferencia") // em_conferencia | para_assinatura | assinado | devolvido | cancelado
  checagens     String    @default("[]") // JSON: última conferência automática
  checadoEm     DateTime  @default(now())
  dadosDe       String    @default("")
  parecer       String? // pode_assinar | com_ressalva | nao_assinar
  parecerTexto  String    @default("")
  parecerPor    String?
  parecerEm     DateTime?
  decisaoPor    String?
  decisaoEm     DateTime?
  decisaoTexto  String    @default("")
  enviadoPor    String
  enviadoPorId  String    @default("")
  enviadoPerfil String
  enviadoEm     DateTime  @default(now())

  eventos EventoDocumento[]
  anexos  AnexoDocumento[]

  @@index([prefeituraId, status])
  @@index([prefeituraId, orgaoCod])
  @@map("fin_documento_assinatura")
}

model EventoDocumento {
  id           Int                 @id @default(autoincrement())
  prefeituraId String
  documentoId  Int
  tipo         String // enviado | conferido | parecer | assinado | devolvido | cancelado | nota | anexo
  texto        String              @default("")
  por          String
  quando       DateTime            @default(now())
  documento    DocumentoAssinatura @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([prefeituraId, documentoId])
  @@map("fin_evento_documento")
}

// PDF do documento. O arquivo fica em FIN_DADOS_DIR/<prefeitura>/anexos/, com o nome = SHA-256 do conteúdo.
// Não se apaga: "retirar" só esconde, e o hash entra na ciência do prefeito (prova de qual arquivo ele viu).
model AnexoDocumento {
  id           Int                 @id @default(autoincrement())
  prefeituraId String
  documentoId  Int
  nome         String // nome original do arquivo, só para exibir
  bytes        Int
  sha256       String
  enviadoPor   String
  enviadoEm    DateTime            @default(now())
  removidoPor  String?
  removidoEm   DateTime?
  documento    DocumentoAssinatura @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([prefeituraId, documentoId])
  @@map("fin_anexo_documento")
}

// Relatório de auditoria interna gerado e guardado: o conteúdo (JSON) não muda depois de gravado e o
// SHA-256 prova o que o relatório mostrava naquela data.
model RelatorioAuditoria {
  id           Int      @id @default(autoincrement())
  prefeituraId String
  geradoEm     DateTime @default(now())
  geradoPor    String
  conteudo     String // JSON
  sha256       String
  criticos     Int
  atencao      Int

  @@index([prefeituraId, geradoEm])
  @@map("fin_relatorio_auditoria")
}
