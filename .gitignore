npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# env
.env
.env.local
prisma/dev.db

# backups locais de dados (dumps de produção, não versionar)
/backups

# Fazenda: planilha de folha de pagamento (nomes + salários de servidores)
# nunca vai pro repositório (é público, mas não é pra ficar no histórico do
# GitHub) — no VPS ela fica só no disco, fora do git. Ambiente virtual dos
# coletores Python também fica de fora.
scripts/fazenda-atualizador/RH_*.xls
scripts/fazenda-atualizador/.venv/
# HTML do painel Fazenda gerado (embute nome e salário de cada servidor):
# fica só em private/fazenda/ no servidor, nunca no git. A pasta existe no
# repositório (via .gitkeep) pra o COPY do Dockerfile não falhar.
private/fazenda/*
!private/fazenda/.gitkeep
public/fazenda/painel.html
scripts/fazenda-atualizador/auto_atualizar.log
scripts/fazenda-atualizador/_cache/
scripts/Painel_Receita_Despesas.html
